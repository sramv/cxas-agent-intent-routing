# Google Cloud & CXAS (Customer Engagement Suite) Configuration
GCP_PROJECT_ID="<YOUR_GCP_PROJECT_ID>"
GCP_LOCATION="us"

# CXAS Application & Agent Configuration
CXAS_V1_APP_ID="<YOUR_V1_APP_ID>"
CXAS_V2_APP_NAME="telco-agent-fast-intent-router"
CXAS_ROOT_AGENT_NAME="Telecommunications Steering agent"
CXAS_TOOLSET_ID="diffusion_gemma_classifier"

# Vertex AI Dedicated Endpoint for Fast Intent Classifier
ROUTER_ENDPOINT_DNS="https://<YOUR_ENDPOINT_ID>.<YOUR_REGION>-<YOUR_PEERING_ID>.prediction.vertexai.goog"
ROUTER_ENDPOINT_PATH="projects/<YOUR_PROJECT_NUMBER>/locations/<YOUR_REGION>/endpoints/<YOUR_ENDPOINT_ID>"
ROUTER_MODEL_NAME="intent-classifier-model"

# Cloud Run OpenAPI Tool Service URL
CLOUD_RUN_SERVICE_URL="https://<YOUR_CLOUD_RUN_SERVICE_URL>"

# Benchmark Cost & Baseline Model Settings
BASELINE_LLM_MODEL_NAME="baseline-llm"
LLM_INPUT_COST_PER_1M="0.15"
LLM_OUTPUT_COST_PER_1M="0.60"
