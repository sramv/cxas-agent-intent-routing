{
  "openapi": "3.0.0",
  "info": {
    "title": "Telco Intent Classifier API",
    "version": "1.0.0",
    "description": "Classifies user telecommunications queries into 1 of 160 intents and returns the target sub-agent."
  },
  "servers": [
    {
      "url": "https://<YOUR_CLOUD_RUN_SERVICE_URL>"
    }
  ],
  "paths": {
    "/classify": {
      "post": {
        "operationId": "classify_telco_intent",
        "summary": "Classify a customer telecommunications query into one of 160 intents and 8 sub-agents.",
        "description": "Calls the intent router service on Cloud Run to classify a customer telco utterance into intent_id and sub_agent.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "utterance"
                ],
                "properties": {
                  "utterance": {
                    "type": "string",
                    "description": "The exact customer query to classify."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Classification result with intent_id, target sub_agent, and token probability confidence scores.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "intent_id": {
                      "type": "string"
                    },
                    "intent_name": {
                      "type": "string"
                    },
                    "sub_agent": {
                      "type": "string"
                    },
                    "intent_confidence": {
                      "type": "number"
                    },
                    "sub_agent_confidence": {
                      "type": "number"
                    },
                    "inference_latency_ms": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}